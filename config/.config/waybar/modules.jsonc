{
  "custom/separator" : {
    "format": "|",
    "tooltip": false,
    "return-type": "json"
  },
  "custom/mpris-separator": {
    "exec": "playerctl -l 2>/dev/null | grep -q '.' && echo '|' || echo ''",
    "interval": 2,
    "return-type": "text",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 3
    },
    "cursor": true,
    "on-scroll-down": "hyprctl dispatch workspace r-1",
    "on-scroll-up": "hyprctl dispatch workspace next"
  },
  "hyprland/window": {
    "max-length": 45
  },
  "clock": {
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format": "{:%d - %H:%M}",
    "format-alt": "{:%a %d %b - %H:%M}",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<b>{}</b>",
        "days": "<span color='#d8dee9'><b>{}</b></span>",
        "today": "<span color='#8fbcbb'><b><u>{}</u></b></span>"
      }
    }
  },
  "mpris": {
    "format": "{artist} - {title}",
    "tooltip-format": "{album}",
    "format-paused": "{artist} - {title}",
    "on-click": "playerctl play-pause",
    "on-right-click": "playerctl stop",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "max-length": 30
  },
  "battery": {
    "format": "{capacity} {icon} ",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "",
    "on-scroll-down": "",
    "format-charging": "{capacity} 󰂄",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "wireplumber": {
    "align": 1,
    "format": "{volume} {icon}",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "format-muted": " 󰝟 ",
    "on-click": "$HOME/.config/hypr/scripts/wiremix-toggle.sh",
    "reverse-scrolling": 1,
    "smooth-scrolling-threshold": 0.5
  },
  "backlight": {
    "align": 1,
    "format": "{percent} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "reverse-scrolling": 1,
    "smooth-scrolling-threshold": 1
  }
}
