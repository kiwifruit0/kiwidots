{
  "layer": "top",
  "position": "bottom",
  "margin-bottom": 5,
  "group/main": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "custom/separator",
      "hyprland/workspaces",
      "custom/separator",
      "mpris",
      "custom/mpris-separator",
      "wireplumber",
      "backlight",
      "battery"
    ]
  },
  "modules-center": [
    "group/main"
  ],
  "include": [
    "~/.config/waybar/modules.jsonc"
  ]
}
