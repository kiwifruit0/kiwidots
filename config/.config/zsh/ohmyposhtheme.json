{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#8CAAEE",
    "closer": "p:os",
    "lavender": "#BABBF1",
    "os": "#ACB0BE",
    "pink": "#F4B8E4"
  },
  "transient_prompt": {
    "template": "\uf105 ",
    "background": "transparent",
    "foreground_templates": [
      "{{if gt .Code 0}}#bf616a{{end}}",
      "{{if eq .Code 0}}p:lavender{{end}}"
    ]
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "hide_root_location": true,
            "home_icon": "~",
            "max_depth": 3,
            "style": "full"
          },
          "template": "{{ .Path }}  ",
          "foreground": "p:pink",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "async": true,
            "branch_icon": "\ue725 ",
            "fetch_stash_count": false,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": false
          },
          "template": "{{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} *{{ end }} {{ if gt .Behind 0 }}\u21e3{{ end }}{{ if gt .Ahead 0 }}\u21e1{{ end }}",
          "foreground": "p:lavender",
          "type": "git",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "async": true,
            "fetch_version": false
          },
          "template": "\ue73c {{ .Venv }}",
          "foreground": "p:lavender",
          "type": "python",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\uf105",
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{if gt .Code 0}}#bf616a{{end}}",
            "{{if eq .Code 0}}p:lavender{{end}}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true,
  "enable_cursor_positioning": true
}
